    "type": "git",
    "url": "git+https://github.com/allonsy-studio/markdown-it-anchor-sections.git"
  },
  "bugs": {
    "url": "https://github.com/allonsy-studio/markdown-it-anchor-sections/issues"
  },
  "type": "module",
