    "test": "node test.js",
    "version": "opx release version && yarn install --mode update-lockfile"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@11ty/eleventy-plugin-webc": "^0.11.2",
    "@allons-y/opx-cli": "^0.2.0",
    "@allons-y/opx-lint-js": "^1.0.0",
    "@allons-y/opx-lint-md": "^0.1.0",
    "@allons-y/opx-release": "^0.1.1",
    "@allons-y/webc-code-sample": "^0.1.0-beta.1",
    "@allons-y/webc-oss-site": "^0.1.0-beta.1",
    "@allons-y/webc-patterns": "^0.1.0-beta.1",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "axe-core": "^4.11.0",
    "c8": "^12.0.0",
    "cypress": "^15.21.1",
    "cypress-axe": "^1.7.0",
    "html-minifier": "^4.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "markdown-it": "^14.1.1",
    "markdown-it-attrs": "^4.3.1",
    "prettier": "^3.8.3",
    "prettier-package-json": "^2.8.0"
  },
  "keywords": [
    "markdown-it",
    "markdown-it-plugin"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/castastrophe"
    },
    {
