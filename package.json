{
  "name": "@allons-y/markdown-it-anchor-sections",
  "version": "1.1.0",
  "description": "Create anchor sections from markdown headers",
  "license": "Apache-2.0",
  "author": "Cassondra Roberts <castastrophe@users.noreply.github.com> (https://allons-y.studio)",
  "contributors": [
    "Arve Seljebu"
  ],
  "homepage": "https://github.com/allonsy-studio/markdown-it-anchor-sections#readme",
